# Required for catalog, bookings, orders, and checkout persistence.
MONGODB_URI=mongodb://127.0.0.1:27017/we-decor-4u

# Public canonical site URL, without a trailing slash.
SITE_URL=http://localhost:3000

# Contact details are shown when configured; BUSINESS_EMAIL receives form notifications.
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
SUPPORT_HOURS=
INSTAGRAM_URL=
PINTEREST_URL=
FACEBOOK_URL=

# Resend sends contact, B2B, interior survey, and event enquiry notifications.
# EMAIL_FROM must use a sender/domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=

# Tax rates are business-configured percentages, by ISO country code.
# Example shape only: {"IN":18,"US":0}; replace with approved rates before checkout.
TAX_RATES_JSON=

# Shipping rate table in minor currency units, keyed by country and method.
# Example shape only: {"IN":{"STANDARD":{"baseMinor":0,"perKgMinor":0}},"US":{"AIR":{"baseMinor":0,"perKgMinor":0},"OCEAN":{"baseMinor":0,"perKgMinor":0}}}
SHIPPING_RATES_JSON=

# Optional country FX rates. INR is the base currency and uses rate 1.
# Example shape only: {"US":{"currency":"USD","rate":0},"GB":{"currency":"GBP","rate":0}}
FX_RATES_JSON=

# Razorpay server credentials. Checkout stays disabled until configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional analytics IDs. Never put server-side secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=

# Optional site verification values from the respective platforms.
GOOGLE_SITE_VERIFICATION=
META_SITE_VERIFICATION=
PINTEREST_SITE_VERIFICATION=
